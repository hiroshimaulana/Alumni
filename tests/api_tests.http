### 22. Error Handling: Undefined Web Route (GET /invalid-endpoint)
# Expect HTTP 404 Not Found status code and views/404.html error view
GET {{baseUrl}}/invalid-endpoint
Accept: text/html

### 23. Error Handling: Undefined API Route (GET /api/invalid-endpoint)
# Expect HTTP 404 Not Found status code and structured JSON error response
GET {{baseUrl}}/api/invalid-endpoint
Accept: application/json

### 24. Error Handling: Undefined POST Route (POST /invalid-endpoint)
# Expect HTTP 404 Not Found status code (never 200 skeleton fallback)
POST {{baseUrl}}/invalid-endpoint
Content-Type: application/json

{
    "query": "test_invalid_path"
}

### 25. Error Handling: Missing Static Asset (GET /assets/missing.css)
# Expect HTTP 404 Not Found status code and 404 error page
GET {{baseUrl}}/assets/missing.css
Accept: text/html

### 26. Error Handling: 405 Method Not Allowed (POST /users/create)
# Expect HTTP 405, Allow: GET header, and JSON error body
POST {{baseUrl}}/users/create
Content-Type: application/json

{}

### 27. Auth: POST /api/login — Missing Content-Type (expect 400)
POST {{baseUrl}}/api/login

{"email":"admin@istanbul.edu.tr","password":"AdminMis2026!"}

### 28. Auth: POST /api/login — Malformed JSON (expect 400)
POST {{baseUrl}}/api/login
Content-Type: application/json

not valid json at all

### 29. Auth: POST /api/login — Missing password field (expect 422)
POST {{baseUrl}}/api/login
Content-Type: application/json

{"email":"admin@istanbul.edu.tr"}

### 30. Auth: POST /api/login — Invalid email syntax (expect 422)
POST {{baseUrl}}/api/login
Content-Type: application/json

{"email":"not-an-email","password":"secret123"}

### 31. Auth: POST /api/login — Short password < 6 chars (expect 422)
POST {{baseUrl}}/api/login
Content-Type: application/json

{"email":"admin@istanbul.edu.tr","password":"123"}

