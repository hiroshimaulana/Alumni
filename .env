# ==============================================================================
# Istanbul University Faculty of Economics
# Department of Management Information Systems (MIS)
# Alumni Portal & Tracking System - Local Environment Configuration
# ==============================================================================

# Application Setup
APP_NAME="Istanbul University MIS Alumni Portal"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Connection (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iu_mis_alumni
DB_USERNAME=root
DB_PASSWORD=""
DB_CHARSET=utf8mb4

# Docker Compose Port Forwarding
DOCKER_DB_PORT=3306
DOCKER_WEB_PORT=8000
DOCKER_PMA_PORT=8080
